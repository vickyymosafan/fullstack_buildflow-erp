# Environment Configuration
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://buildflow:buildflow_secret@localhost:5432/buildflow_erp?schema=public"

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super_secret_buildflow_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# S3 Compatible Object Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=buildflow_admin
S3_SECRET_KEY=buildflow_storage_secret
S3_BUCKET_NAME=buildflow-documents
S3_REGION=us-east-1

# Client URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

